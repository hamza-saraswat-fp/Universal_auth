# Base URL of the fieldpulse-auth Supabase project.
# A service that only verifies tokens needs this and nothing else — JWKS is
# public, so verification requires no API key.
FP_AUTH_URL=https://<PROJECT_REF>.supabase.co

# Same value, exposed to the browser. Needed by apps that run a sign-in flow.
NEXT_PUBLIC_FP_AUTH_URL=https://<PROJECT_REF>.supabase.co

# Publishable key for the auth project. Browser-safe by design, but still lives
# in your env store, not in git. Never put an sb_secret_ key here.
NEXT_PUBLIC_FP_AUTH_PUBLISHABLE_KEY=sb_publishable_<REPLACE_ME>
